rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /stories/{storyId} {
      // Anyone (logged in or not) can read any story document, including
      // drafts. Drafts are kept out of the public Home feed by filtering
      // client-side in Home.jsx instead of at the rules level — Firestore
      // rejects an entire collection query if it can't prove every possible
      // matching document satisfies the read rule, and the Home feed query
      // doesn't filter by `status` itself (see Home.jsx for why), so a
      // stricter per-document rule here would break that query outright.
      // Practically: a draft is only reachable if someone has its exact
      // (random, unguessable) story URL — it just won't show up anywhere.
      allow read: if true;

      // Only a signed-in user can create a story, and only as themselves.
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.wordCount is int
                    && request.resource.data.wordCount <= 2000;

      // The author can edit or delete any field on their own story.
      // Any signed-in user may only ever touch the `likedBy` field (used by
      // the like button). Anyone at all — including signed-out readers — may
      // touch only the `views` field, since view counting shouldn't require
      // an account. Everything else about the story is locked to its author.
      allow update: if (request.auth != null && resource.data.authorId == request.auth.uid)
                    || (request.auth != null
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy']))
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);

      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        // Anyone can read comments.
        allow read: if true;

        // Only a signed-in user can post a comment, and only as themselves.
        allow create: if request.auth != null
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000;

        // Only the comment's author can delete it. Comments aren't editable
        // once posted (delete and repost instead).
        allow delete: if request.auth != null
                      && resource.data.authorId == request.auth.uid;
        allow update: if false;
      }

      // One doc per calendar day holding that day's view count, used for
      // the "views over time" sparkline on My Stories. Anyone can bump the
      // count (view counting doesn't require an account), but only the
      // story's author can read the breakdown — it's their analytics, not
      // public data.
      match /dailyViews/{day} {
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid;
        allow create: if request.resource.data.keys().hasOnly(['count'])
                      && request.resource.data.count is int;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']);
        allow delete: if false;
      }
    }

    // Reports from the "Report" button on a story. Write-only from the app —
    // nobody can read, edit, or delete reports from the client; review them
    // from the Firebase console instead.
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.storyId is string;
    }

    // Profile document per user — holds the custom display name set from
    // the Settings page. Only the user themselves can read or write it.
    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null
                                           && request.auth.uid == userId;
    }
  }
}
